# Kalshi key ID (not the PEM private-key contents).
KALSHI_ACCESS_KEY="PASTE_YOUR_KALSHI_API_KEY_ID_HERE"

# Absolute path to the separate, unencrypted Ed25519 PKCS#8 PEM private key.
# Keep that key file outside this repository; do not paste the PEM contents here.
KALSHI_PRIVATE_KEY_PATH="/Users/yourname/kalshi/private-key.pem"

# Choose "demo", "prod", or "production". The API key must match.
KALSHI_ENV="demo"

# Optional shared collector settings. The collector defaults to at most 180
# WebSockets (Kalshi Basic tier allows 200 concurrent connections), and
# automatically increases the markets-per-socket batch size to stay under it.
# Each market is subscribed on two redundant WebSockets.
# COLLECTOR_MARKETS_PER_CONNECTION="500"
# Set higher only if your Kalshi tier supports it and no other clients use these slots.
# COLLECTOR_MAX_CONNECTIONS="180"
# Resubscribe a quiet symbol on each socket when it gets fewer than 1 delta
# during a 60-second window. Set the minimum to 0 to disable this behavior.
# COLLECTOR_ACTIVITY_WINDOW_SECS="60"
# COLLECTOR_MIN_UPDATES_PER_WINDOW="1"
# COLLECTOR_QUIET_RESUBSCRIBE_COOLDOWN_SECS="300"
# Rotate each WebSocket connection every six hours.
# COLLECTOR_SOCKET_ROTATION_SECS="21600"
# ORDERBOOK_OUTPUT="./orderbook.sbe"
